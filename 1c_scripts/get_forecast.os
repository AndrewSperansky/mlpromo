// ПолучениеПрогноза
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Продажи = 1;
	PromoID = "Промо-XX";
	ДатаПромо = ТекущаяДата();
КонецПроцедуры



Функция ОтправитьHTTPЗапрос(ПараметрыЗапроса, АдресРесурса, Метод,ТокенАвторизации = Неопределено) Экспорт
	 
	 // СЕРВЕР Promo ML
	 HTTPСоединение = Новый HTTPСоединение("192.168.18.73",,,,,,);
	 
	 // LOCALHOST A.S.
	 //HTTPСоединение = Новый HTTPСоединение("192.168.218.49",8000,,,,,);

	 
	 Заголовки 		= Новый Соответствие;
	 Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	 Заголовки.Вставить("cache-control", "no-cache");  
	 
	 //  ДОБАВИТЬ ТОКЕН (если передан)
     Если ТокенАвторизации <> Неопределено Тогда
         Заголовки.Вставить("Authorization", "Bearer " + ТокенАвторизации);
     КонецЕсли;
	 
	 Запрос = Новый HTTPЗапрос(АдресРесурса,Заголовки);
	 Если НЕ ПараметрыЗапроса = Неопределено Тогда
	     Запрос.УстановитьТелоИзСтроки(ПараметрыЗапроса);
	 КонецЕсли;
	 
	 HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод(Метод,Запрос);
	  
	 Возврат HTTPОтвет;
	 
 КонецФункции   

 
 // ==== Заполнение текущими данными колонок новой строки  =========
 
&НаКлиенте
Процедура ДанныеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.promo_id = PromoID;
		Элемент.ТекущиеДанные.baseline = Продажи;
		Элемент.ТекущиеДанные.week = НеделяГода(ДатаПромо);
		Элемент.ТекущиеДанные.month = Месяц(ДатаПромо);
		Элемент.ТекущиеДанные.sku = "РН235555";
		Элемент.ТекущиеДанные.category = "Охлажденка";
		Элемент.ТекущиеДанные.store_id = "МГЗ №461";
		Элемент.ТекущиеДанные.region = "МСК";
		Элемент.ТекущиеДанные.store_location_type = "Спальный";	
		Элемент.ТекущиеДанные.format_assortment = "na"; 
		Элемент.ТекущиеДанные.adv_carrier = "ЖЦ"; 
		Элемент.ТекущиеДанные.adv_material = "na"; 
		Элемент.ТекущиеДанные.promo_mechanics = "na"; 
		Элемент.ТекущиеДанные.marketing_type = "Скидка по карте!"; 
	КонецЕсли;
	
КонецПроцедуры
 
 
 
// =========== Получение прогноза ===============================
 
&НаКлиенте
Процедура ПолучитьПрогноз(Команда)
	
	ПолучитьПрогнозНаСервере();  
	
	// Получаем данные с сервера
    ДанныеДиаграммы = ПолучитьДанныеДляДиаграммыНаСервере();

    Если ДанныеДиаграммы = Неопределено Тогда
        Сообщить("Нет данных для построения диаграммы!");
        Возврат;
    КонецЕсли;

    // Отображаем диаграмму с полученными данными
    ОтобразитьДиаграмму(ДанныеДиаграммы); 
	
КонецПроцедуры


&НаСервере
Процедура ПолучитьПрогнозНаСервере() 
	
	
	Если Данные.Количество() = 0 Тогда
		Сообщить("Нет данных для получения прогноза");
		Возврат
	КонецЕсли;  
	
	
	МассивЗаписей = Новый Массив;
	
	Для Каждого СтрокаТЗ Из Данные Цикл
		
		Запись = Новый Структура;
		Запись.Вставить("promo_id", СтрокаТЗ.promo_id);
		Запись.Вставить("week", СтрокаТЗ.week);
		Запись.Вставить("month", СтрокаТЗ.month);
		Запись.Вставить("sku", СокрЛП(СтрокаТЗ.sku));  
		Запись.Вставить("category", СтрокаТЗ.category);
		Запись.Вставить("regular_price", СтрокаТЗ.regular_price);
		Запись.Вставить("promo_price", СтрокаТЗ.promo_price);
		Запись.Вставить("store_id", СокрЛП(СтрокаТЗ.store_id));
		Запись.Вставить("region", СтрокаТЗ.region);
		Запись.Вставить("store_location_type", СтрокаТЗ.store_location_type);
		Запись.Вставить("format_assortment", СтрокаТЗ.format_assortment);
        Запись.Вставить("adv_carrier", СтрокаТЗ.adv_carrier);
		Запись.Вставить("adv_material", СтрокаТЗ.adv_material); 
		Запись.Вставить("promo_mechanics", СтрокаТЗ.promo_mechanics);
		Запись.Вставить("marketing_type", СтрокаТЗ.marketing_type);
		Запись.Вставить("baseline", СтрокаТЗ.baseline);
		
		МассивЗаписей.Добавить(Запись);
		
	КонецЦикла;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("requests", МассивЗаписей);
	
	ЗаписьJSON = Новый ЗаписьJSON;  
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, ДанныеЗапроса);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	//Токен = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyIiwicm9sZSI6ImFkbWluIiwiZXhwIjoxNzc5OTcwODI3fQ.wBjPEzz3lfUS2CrgduQOyVBkmc3kuZIeIUzwQz9jSV0";	
	
	//  ПОЛУЧАЕМ ТОКЕН
    Токен = ПолучитьТокенНаСервере();
    Если Токен = "" Тогда
        Сообщить("Не удалось получить токен. Операция отменена.");
        Возврат;
    КонецЕсли;
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/predict/batch";  
	HTTPОтвет = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST", Токен); 
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		
	// 4. Обрабатываем результат
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			
			// ПОЛУЧАЕМ МАССИВ ПРЕДСКАЗАНИЙ
            Предсказания = Ответ.predictions; 
			
			// Очищаем таблицу результатов
        	Результат.Очистить();
			
			Номер = 1;
	        Для Каждого Предсказание Из Предсказания Цикл
	            СтрокаТЗ = Результат.Добавить();
	            
	            СтрокаТЗ.num          = Номер;
	            СтрокаТЗ.promo_price  = Предсказание.promo_price;
	            СтрокаТЗ.k_uplift     = Окр(Предсказание.k_uplift, 3);
	            СтрокаТЗ.forecast     = Окр(Предсказание.prediction_absolute, 2);
	            СтрокаТЗ.baseline     = Окр(Предсказание.baseline, 2);
	            СтрокаТЗ.uplift       = ФорматПрироста(Предсказание.uplift_percent);
	            СтрокаТЗ.interval     = ФорматИнтервала(Предсказание.interval, Предсказание.baseline);
	            
	            Номер = Номер + 1;
	        КонецЦикла;
        
        	Сообщить("✅ Получено " + Строка(Предсказания.Количество()) + " прогнозов");
			
							
		Исключение
			Сообщить("❌ Ошибка: " + ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка HTTP: " + HTTPОтвет.КодСостояния); 
		Сообщить(HTTPОтвет.ПолучитьТелоКакСтроку());
	КонецЕсли;

	 		
КонецПроцедуры


&НаСервере
Процедура ЗапросСтатусаНаСервере()
	 HTTPОтвет = ОтправитьHTTPЗапрос(Неопределено,"/api/v1/system/health","GET");
	 ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
КонецПроцедуры


&НаКлиенте
Процедура ЗапросСтатуса(Команда)
	ЗапросСтатусаНаСервере();
КонецПроцедуры



Функция ФорматПрироста(Процент)
    
    // Проверяем, что Процент — число
    Если ТипЗнч(Процент) <> Тип("Число") Тогда
        Возврат "—";
    КонецЕсли;
    
    Если Процент > 0 Тогда
        Возврат "+" + Формат(Процент, "ЧДЦ=1") + "%";
    Иначе
        Возврат Формат(Процент, "ЧДЦ=1") + "%";
    КонецЕсли;
    
КонецФункции



Функция ФорматИнтервала(Интервал, БазовыеПродажи)
    
    // Проверяем, что Интервал — структура
    Если ТипЗнч(Интервал) <> Тип("Структура") Тогда
        Возврат "—";
    КонецЕсли;
    
    // Проверяем наличие полей lower и upper
    Если НЕ Интервал.Свойство("lower") ИЛИ НЕ Интервал.Свойство("upper") Тогда
        Возврат "—";
    КонецЕсли;
	
	
	Если ТипЗнч(Интервал.lower) <> Тип("Число") ИЛИ ТипЗнч(Интервал.upper) <> Тип("Число") Тогда
        Возврат "—";
    КонецЕсли;
	
	
    // Получаем значения 
	Нижняя = Интервал.lower * БазовыеПродажи;
    Верхняя = Интервал.upper * БазовыеПродажи;
        
    
   	ФорматированныйИнтервал = "[" + Формат(Нижняя, "ЧДЦ=2") + " — " + Формат(Верхняя, "ЧДЦ=2") + "]";
    
    // ДИАГНОСТИКА
	//Сообщить("Верхняя граница интервала доверия = " + Верхняя);
	//Сообщить("Нижняя граница интервала доверия = " + Нижняя);
	//Сообщить("ФорматированныйИнтервал = " + ФорматированныйИнтервал);
    
    Возврат ФорматированныйИнтервал;
    
КонецФункции



Функция ПолучитьТокенНаСервере()
    
    // Данные для входа
    ЛогинДанные = Новый Структура;
    ЛогинДанные.Вставить("email", "dummy@agrohold.ru");
    ЛогинДанные.Вставить("password", "{dummypass}");
    
    // Сериализуем в JSON
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ЛогинДанные);
    JSONСтрока = ЗаписьJSON.Закрыть();
    
    // Отправляем запрос на логин
    Адрес = "/api/v1/auth/login";
    HTTPОтвет = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
    
    Если HTTPОтвет.КодСостояния = 200 Тогда
        ЧтениеJSON = Новый ЧтениеJSON;
        ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
        Ответ = ПрочитатьJSON(ЧтениеJSON);
        
        Токен = Ответ.access_token;
		Сообщить(Токен);
        Сообщить("✅ Токен получен");
        Возврат Токен;
    Иначе
        Сообщить("❌ Ошибка авторизации: " + HTTPОтвет.КодСостояния);
        Сообщить(HTTPОтвет.ПолучитьТелоКакСтроку());
        Возврат "";
    КонецЕсли;
    
КонецФункции


&НаКлиенте
Процедура ОтобразитьДиаграмму(МассивДанных)
    
    Если МассивДанных = Неопределено ИЛИ МассивДанных.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    Диаграмма = ДиаграммаПродаж;
    Диаграмма.Очистить();
    
    // Тип диаграммы
    Диаграмма.ТипДиаграммы = ТипДиаграммы.Гистограмма;
    
    // Заголовок диаграммы
    Диаграмма.ОбластьЗаголовка.Текст = "Сравнение продаж: обычная цена vs промо-цена";
    
    // Создаём серии
    Диаграмма.Серии.Очистить();
    
    Серия1 = Диаграмма.Серии.Добавить();
    Серия1.Текст = "Обычные продажи";        // ✅ Название в легенде
    Серия1.Цвет = Новый Цвет(0, 120, 215);   // Синий
    
    Серия2 = Диаграмма.Серии.Добавить();
    Серия2.Текст = "Прогноз по промо";       // ✅ Название в легенде
    Серия2.Цвет = Новый Цвет(255, 80, 80);   // Красный
    
    // Заполняем данными
    Для Каждого Строка Из МассивДанных Цикл
        Точка = Диаграмма.Точки.Добавить(Строка.Номер);
        Диаграмма.УстановитьЗначение(Точка, 0, Строка.ОбычныеПродажи); // Параметры: (Точка, Серия(индекс), Источник)
        Диаграмма.УстановитьЗначение(Точка, 1, Строка.ПрогнозПромо);
    КонецЦикла;
    
    // Обновляем отображение
     Диаграмма.Обновление = Истина;
    
КонецПроцедуры



&НаСервере
Функция ПолучитьДанныеДляДиаграммыНаСервере()
	
	ДанныеТаблицы = РеквизитФормыВЗначение("Результат");

    Если ДанныеТаблицы.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Создаём МАССИВ структур (это можно передать на клиент)
    МассивДанных = Новый Массив;
    
    Для Каждого СтрокаТЗ Из ДанныеТаблицы Цикл
        СтруктураСтроки = Новый Структура;
        СтруктураСтроки.Вставить("Номер", Строка(СтрокаТЗ.num));
        СтруктураСтроки.Вставить("ОбычныеПродажи", СтрокаТЗ.baseline);
        СтруктураСтроки.Вставить("ПрогнозПромо", СтрокаТЗ.forecast);
        
        МассивДанных.Добавить(СтруктураСтроки);
    КонецЦикла;

    Возврат МассивДанных; 
	
КонецФункции












