// ========== ВАЛЮТНЫЕ КУРСЫ =================== 
&НаКлиенте
Процедура ОтобратьВалютныеКурсы(Команда)
	Валюта = Валюта;
	ДатаНачала = ДатаНачала;
	ДатаОкончания = ДатаОкончания;
	ОтобратьВалютныеКурсыНаСервере(Валюта, ДатаНачала, ДатаОкончания);
КонецПроцедуры


&НаСервере
Процедура ОтобратьВалютныеКурсыНаСервере(Вал, Начало, Окончание)
	
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КурсыВалют.Период КАК date,
		|	КурсыВалют.Валюта.Наименование КАК currency,
		|	КурсыВалют.Курс КАК rate
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И КурсыВалют.Валюта = &Валюта";
	
	Запрос.УстановитьПараметр("Валюта", Вал);
	Запрос.УстановитьПараметр("ДатаНачала", Начало);
	Запрос.УстановитьПараметр("ДатаОкончания", Окончание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Котировки.Очистить();
	Котировки.Загрузить(ТЗ);
	КолЗаписей = Котировки.Количество(); 
	Сообщить("✅  Загружено " + Строка(КолЗаписей) + " строк");

	
КонецПроцедуры  


&НаКлиенте
Процедура ВыгрузитьВалютныеКурсы(Команда)
	ВыгрузитьВалютныеКурсыНаСервере();
КонецПроцедуры


&НаСервере
Процедура ВыгрузитьВалютныеКурсыНаСервере()
	
	Если Котировки.Количество() = 0 Тогда
		Сообщить("Нет данных для выгрузки");
		Возврат;
	КонецЕсли;
	
	// 1. Формируем данные
	МассивЗаписей = Новый Массив;
	
	Для каждого СтрокаТЗ Из Котировки Цикл
		Запись = Новый Структура;
		Запись.Вставить("date", Формат(СтрокаТЗ.date, "ДФ=yyyy-MM-dd"));
		Запись.Вставить("currency", СтрокаТЗ.currency);
		Запись.Вставить("rate", СтрокаТЗ.rate);
		МассивЗаписей.Добавить(Запись);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("records", МассивЗаписей);
	
	// 2. Сериализуем в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/torch/push/exchange-rates";
	Результат = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
	
	// 4. Обрабатываем результат
	Если Результат.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			Сообщить("✅ Выгружено " + Строка(Ответ.records_loaded) + " записей");
		Исключение
			Сообщить("✅ Выгружено успешно");
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка: " + Результат.КодСостояния);
	КонецЕсли;
	
КонецПроцедуры 


&НаКлиенте
Процедура ОчиститьКотировки(Команда)
	Котировки.Очистить();
КонецПроцедуры  


// ========== КАЛЕНДАРИ (СиБ) ===============
// Используется производственный календарь БД СиБ

&НаКлиенте
Процедура ОтобратьКалендари(Команда)
	ДатаНачала = ДатаНачала;
	ДатаОкончания = ДатаОкончания;
	ОтобратьКалендариНаСервере(ДатаНачала, ДатаОкончания);
КонецПроцедуры


&НаСервере
Процедура ОтобратьКалендариНаСервере(Начало, Окончание)
	
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата КАК date,
		|	НЕДЕЛЯ(ДанныеПроизводственногоКалендаря.Дата) КАК week,
		|	ДанныеПроизводственногоКалендаря.Год КАК year,
		|	ДанныеПроизводственногоКалендаря.ВидДня КАК day_type
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата >= &ДатаНачало
		|	И ДанныеПроизводственногоКалендаря.Дата <= &ДатаОкончание";
	
	Запрос.УстановитьПараметр("ДатаНачало", Начало);
	Запрос.УстановитьПараметр("ДатаОкончание", Окончание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Календари.Очистить();
	Календари.Загрузить(ТЗ);
	КолЗаписей = Календари.Количество(); 
	Сообщить("✅  Загружено " + Строка(КолЗаписей) + " строк");
	
	
КонецПроцедуры    



&НаКлиенте
Процедура ВыгрузитьКалендари(Команда)
	ВыгрузитьКалендариНаСервере();
КонецПроцедуры


&НаСервере
Процедура ВыгрузитьКалендариНаСервере()
	
	Если Календари.Количество() = 0 Тогда
		Сообщить("Нет данных для выгрузки!");	
		Возврат;	
	КонецЕсли;  
	
	//Формируем массив записей
	
	МассивЗаписей = Новый Массив;
	
	Для каждого СтрокаТЗ Из Календари Цикл
		Запись = Новый Структура;
		Запись.Вставить("date", Формат(СтрокаТЗ.date, "ДФ=yyyy-MM-dd"));
		Запись.Вставить("day_type", СтрокаТЗ.day_type);
		Запись.Вставить("week", СтрокаТЗ.week);
	    Запись.Вставить("year", СтрокаТЗ.year); 
		МассивЗаписей.Добавить(Запись);
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("records", МассивЗаписей);
	
	// Сериализуем в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/torch/push/calendar";
	Результат = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
	
	// 4. Обрабатываем результат
	Если Результат.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			Сообщить("✅  Выгружено " + Строка(Ответ.records_loaded) + " записей");
		Исключение
			Сообщить("✅  Выгружено успешно");
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка: " + Результат.КодСостояния);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьКалендари(Команда)
	Календари.Очистить();
КонецПроцедуры      


// ========== ЧЕКИ (Розница) ===============


&НаКлиенте
Процедура ОтобратьЧеки(Команда)
	ДатаНачала = ДатаНачала;
	ДатаОкончания = ДатаОкончания;
	ОтобратьЧекиНаСервере(ДатаНачала, ДатаОкончания);
КонецПроцедуры


&НаСервере
Процедура ОтобратьЧекиНаСервере(Начало, Окончание)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ЧекККМ.Дата, ДЕНЬ) КАК date,
		|	НЕДЕЛЯ(ЧекККМ.Дата) КАК week,
		|	ЧекККМ.Магазин.Код КАК store_code,
		|	ЧекККМ.Магазин.Наименование КАК store_name,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМ.Номер) КАК cheque_count,
		|	СУММА(ЧекККМ.СуммаДокумента) КАК total_amount,
		|	ОКР(ВЫБОР
		|			КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМ.Номер) > 0
		|				ТОГДА СУММА(ЧекККМ.СуммаДокумента) / КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЧекККМ.Номер)
		|			ИНАЧЕ 0
		|		КОНЕЦ, 2) КАК average_amount
		|ИЗ
		|	Документ.ЧекККМ КАК ЧекККМ
		|ГДЕ
		|	ЧекККМ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ЧекККМ.Дата, ДЕНЬ),
		|	ЧекККМ.Магазин.Код,
		|	ЧекККМ.Магазин.Наименование,
		|	НЕДЕЛЯ(ЧекККМ.Дата)
		|
		|УПОРЯДОЧИТЬ ПО
		|	date,
		|	store_name";  
	
	
	Запрос.УстановитьПараметр("ДатаНачала", Начало);
	Запрос.УстановитьПараметр("ДатаОкончания", Окончание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Чеки.Очистить();
	Чеки.Загрузить(ТЗ);
	КолЗаписей = Чеки.Количество(); 
	Сообщить("✅  Загружено " + Строка(КолЗаписей) + " строк");

	
КонецПроцедуры


&НаКлиенте
Процедура ВыгрузитьЧеки(Команда)
	ВыгрузитьЧекиНаСервере();
КонецПроцедуры  


&НаСервере
Процедура ВыгрузитьЧекиНаСервере()
	
	Если Чеки.Количество() = 0 Тогда
		Сообщить("Данных для выгрузки нет!");
		Возврат;
	КонецЕсли;
		
	МассивЗаписей = Новый Массив;
	
	Для Каждого СтрокаТЗ Из Чеки Цикл
		
		Запись = Новый Структура;
		Запись.Вставить("date", СтрокаТЗ.date); 
		Запись.Вставить("week", СтрокаТЗ.week);
		Запись.Вставить("store_code", СтрокаТЗ.store_code);
		Запись.Вставить("store_name", СтрокаТЗ.store_name);
		Запись.Вставить("cheque_count", СтрокаТЗ.cheque_count);
		Запись.Вставить("total_amount", СтрокаТЗ.total_amount);
		Запись.Вставить("average_amount", СтрокаТЗ.average_amount); 
		МассивЗаписей.Добавить(Запись);		
		
	КонецЦикла; 
	
	
	Данные = Новый Структура;
	Данные.Вставить("records", МассивЗаписей);
		
	// Сериализуем в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/torch/push/average-cheque";
	Результат = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
		
	// 4. Обрабатываем результат
	Если Результат.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			Сообщить("✅ Выгружено " + Строка(Ответ.records_loaded) + " записей");
		Исключение
			Сообщить("✅ Выгружено успешно");
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка: " + Результат.КодСостояния); 
		Сообщить("Тело ответа: " + Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОчиститьЧеки(Команда)
	Чеки.Очистить();
КонецПроцедуры


// ========== ПРОДАЖИ (Розница) ===============


&НаКлиенте
Процедура ОтобратьПродажи(Команда)
	
	ДатаНачала = ДатаНачала;
	ДатаОкончания = ДатаОкончания;
	ОтобратьПродажиНаСервере(ДатаНачала, ДатаОкончания);
	
КонецПроцедуры


&НаСервере
Процедура ОтобратьПродажиНаСервере(Начало, Окончание)
	
	Список = Новый СписокЗначений; 
	Список.Добавить("CU-00000757");
	Список.Добавить("CU-00000760");
	Список.Добавить("CU-00000761");
	Список.Добавить("CU-00000762");
	Список.Добавить("CU-00000764");
	Список.Добавить("CU-00000776");
	Список.Добавить("CU-00000777");
	Список.Добавить("CU-00000778");
	Список.Добавить("CU-00000795");
	Список.Добавить("CU-00000803");
	Список.Добавить("CU-00000805");
	Список.Добавить("CU-00000975");
	Исключения = Список;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(ПродажиОбороты.ДокументПродажи.Дата, ДЕНЬ) КАК date,
		|	НЕДЕЛЯ(ПродажиОбороты.ДокументПродажи.Дата) КАК week,
		|	ПродажиОбороты.Магазин.Наименование КАК store_name,
		|	ПродажиОбороты.Магазин.Код КАК store_code,
		|	ПродажиОбороты.Магазин.КСТ_Область КАК oblast,
		|	ПродажиОбороты.Магазин.КСТ_Регион КАК region,
		|	ПродажиОбороты.Номенклатура.Наименование КАК sku_name,
		|	ПродажиОбороты.Номенклатура.Код КАК sku_code,
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование
		|		ИНАЧЕ ""ПРОЧЕЕ""
		|	КОНЕЦ КАК category,
		|	ПродажиОбороты.Номенклатура.ЕдиницаИзмерения КАК uom,
		|	СУММА(ПродажиОбороты.КоличествоОборот) КАК quantity,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК revenue
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ПродажиОбороты
		|ГДЕ
		|	НЕ ПродажиОбороты.Номенклатура.Код В (&Исключения)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Номенклатура.Код,
		|	ПродажиОбороты.Номенклатура.ЕдиницаИзмерения,
		|	ПродажиОбороты.Магазин.Наименование,
		|	ПродажиОбороты.Магазин.КСТ_Область,
		|	ПродажиОбороты.Магазин.КСТ_Регион,
		|	ПродажиОбороты.Номенклатура.Наименование,
		|	НАЧАЛОПЕРИОДА(ПродажиОбороты.ДокументПродажи.Дата, ДЕНЬ),
		|	ПродажиОбороты.Магазин.Код,
		|	НЕДЕЛЯ(ПродажиОбороты.ДокументПродажи.Дата),
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование
		|		ИНАЧЕ ""ПРОЧЕЕ""
		|	КОНЕЦ
		|
		|ИМЕЮЩИЕ
		|	СУММА(ПродажиОбороты.СтоимостьОборот) >= 3000
		|
		|УПОРЯДОЧИТЬ ПО
		|	revenue УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаНачала", Начало);
	Запрос.УстановитьПараметр("ДатаОкончания", Окончание);
	Запрос.УстановитьПараметр("Исключения", Исключения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Продажи.Очистить();
	Продажи.Загрузить(ТЗ);
	КолЗаписей = Продажи.Количество(); 
	Сообщить("✅  Загружено " + Строка(КолЗаписей) + " строк"); 

	
КонецПроцедуры


&НаКлиенте
Процедура ВыгрузитьПродажи(Команда)
	ВыгрузитьПродажиНаСервере();
КонецПроцедуры 


&НаСервере
Процедура ВыгрузитьПродажиНаСервере()
	
	Если Продажи.Количество() = 0 Тогда
		Сообщить("Нет данных для выгрузки");
		Возврат
	КонецЕсли;  
	
	МассивЗаписей = Новый Массив;
	
	Для Каждого СтрокаТЗ Из Продажи Цикл
		
		Запись = Новый Структура;
		Запись.Вставить("date", СтрокаТЗ.date);
		Запись.Вставить("week", СтрокаТЗ.week);
		Запись.Вставить("store_name", СтрокаТЗ.store_name);
		Запись.Вставить("store_code", СокрЛП(СтрокаТЗ.store_code));
		Запись.Вставить("oblast", СтрокаТЗ.oblast);
		Запись.Вставить("region", СтрокаТЗ.region);
		Запись.Вставить("sku_name", СтрокаТЗ.sku_name);
		Запись.Вставить("sku_code", СокрЛП(СтрокаТЗ.sku_code));
		Запись.Вставить("category", СтрокаТЗ.category);
		Запись.Вставить("uom", СтрокаТЗ.uom);
		Запись.Вставить("quantity", СтрокаТЗ.quantity);
		Запись.Вставить("revenue", СтрокаТЗ.revenue);
		МассивЗаписей.Добавить(Запись);
		
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("records", МассивЗаписей);
	
	ЗаписьJSON = Новый ЗаписьJSON;  
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/torch/push/sales-fact";  
	//Адрес = "/api/v1/ml/torch/push/sales-fact-test";
	Результат = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
		
	// 4. Обрабатываем результат
	Если Результат.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			Сообщить("✅ Выгружено " + Строка(Ответ.records_loaded) + " записей");
		Исключение
			Сообщить("✅ Выгружено успешно");
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка: " + Результат.КодСостояния);
	КонецЕсли;
	
	
КонецПроцедуры

 

&НаКлиенте
Процедура ОчиститьПродажи(Команда)
	Продажи.Очистить();
КонецПроцедуры


// ========== ЦЕНЫ ПРОДАЖ (Розница) ===============


&НаКлиенте
Процедура ОтобратьЦены(Команда)
	ДатаОкончания = ДатаОкончания;
	ОтобратьЦеныНаСервере(ДатаОкончания);
КонецПроцедуры 


&НаСервере
Процедура ОтобратьЦеныНаСервере(Окончание)
	
	Список = Новый СписокЗначений;
	Список.Добавить("CU-00000757");
	Список.Добавить("CU-00000760");
	Список.Добавить("CU-00000761");
	Список.Добавить("CU-00000762");
	Список.Добавить("CU-00000764");
	Список.Добавить("CU-00000776");
	Список.Добавить("CU-00000777");
	Список.Добавить("CU-00000778");
	Список.Добавить("CU-00000795");
	Список.Добавить("CU-00000803");
	Список.Добавить("CU-00000805");
	Список.Добавить("CU-00000975");
	Исключения = Список;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПродажиОбороты.Номенклатура.Код КАК НоменклатураКод,
		|	ПродажиОбороты.Номенклатура.Представление КАК НоменклатураПредставление,
		|	ПродажиОбороты.Номенклатура КАК Номенклатура,
		|	СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот,
		|	СУММА(ПродажиОбороты.СтоимостьОборот) КАК СтоимостьОборот,
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование
		|		ИНАЧЕ ""ПРОЧЕЕ""
		|	КОНЕЦ КАК Категория
		|ПОМЕСТИТЬ втРН
		|ИЗ
		|	РегистрНакопления.Продажи.Обороты(НАЧАЛОПЕРИОДА(&ДатаНедели, НЕДЕЛЯ), КОНЕЦПЕРИОДА(&ДатаНедели, НЕДЕЛЯ), , ) КАК ПродажиОбороты
		|ГДЕ
		|	НЕ ПродажиОбороты.Номенклатура.Код В (&Исключения)
		|	И ПродажиОбороты.СтоимостьОборот >= 25000
		|
		|СГРУППИРОВАТЬ ПО
		|	ПродажиОбороты.Номенклатура,
		|	ПродажиОбороты.Номенклатура.Код,
		|	ПродажиОбороты.Номенклатура.Представление,
		|	ВЫБОР
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Родитель.Наименование
		|		КОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование ЕСТЬ НЕ NULL 
		|			ТОГДА ПродажиОбороты.Номенклатура.Родитель.Наименование
		|		ИНАЧЕ ""ПРОЧЕЕ""
		|	КОНЕЦ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&ДатаНедели, НЕДЕЛЯ), ДЕНЬ) КАК date,
		|	НЕДЕЛЯ(&ДатаНедели) КАК week,
		|	втРН.НоменклатураКод КАК sku_code,
		|	втРН.Номенклатура КАК sku_name,
		|	втРН.Категория КАК category,
		|	МИНИМУМ(ЦеныНоменклатурыСрезПоследних.Цена) КАК price
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(КОНЕЦПЕРИОДА(&ДатаНедели, НЕДЕЛЯ), ) КАК ЦеныНоменклатурыСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРН КАК втРН
		|		ПО (втРН.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура)
		|
		|СГРУППИРОВАТЬ ПО
		|	втРН.НоменклатураКод,
		|	втРН.Номенклатура,
		|	втРН.Категория";
	
	Запрос.УстановитьПараметр("ДатаНедели", Окончание);
	Запрос.УстановитьПараметр("Исключения", Исключения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗ = РезультатЗапроса.Выгрузить();
	
	Цены.Очистить();
	Цены.Загрузить(ТЗ);
	КолЗаписей = Цены.Количество(); 
	Сообщить("✅  Загружено " + Строка(КолЗаписей) + " строк");
		
КонецПроцедуры



&НаКлиенте
Процедура ВыгрузитьЦены(Команда)
	ВыгрузитьЦеныНаСервере();
КонецПроцедуры 


&НаСервере
Процедура ВыгрузитьЦеныНаСервере()
	
	Если Цены.Количество() = 0 Тогда
		Сообщить("Нет данных для выгрузки");
		Возврат
	КонецЕсли;
	
	МассивЗаписей = Новый Массив;
	
	Для Каждого СтрокаТЗ Из Цены Цикл
		
		Запись = Новый Структура;
		Запись.Вставить("date", СтрокаТЗ.date);
		Запись.Вставить("week", СтрокаТЗ.week);
		Запись.Вставить("sku_code", СокрЛП(СтрокаТЗ.sku_code));
		Запись.Вставить("sku_name", СтрокаТЗ.sku_name);
		Запись.Вставить("category", СтрокаТЗ.category);
		Запись.Вставить("price", СтрокаТЗ.price);
		МассивЗаписей.Добавить(Запись);
	КонецЦикла;  
	
	Данные = Новый Структура;
	
	Данные.Вставить("records", МассивЗаписей);
	
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	JSONСтрока = ЗаписьJSON.Закрыть();
	
	
	// 3. Отправляем запрос
	Адрес = "/api/v1/ml/torch/push/retail-prices";
	Результат = ОтправитьHTTPЗапрос(JSONСтрока, Адрес, "POST");
		
	// 4. Обрабатываем результат
	Если Результат.КодСостояния = 200 Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Ответ = ПрочитатьJSON(ЧтениеJSON);
			Сообщить("✅ Выгружено " + Строка(Ответ.records_loaded) + " записей");
		Исключение
			Сообщить("✅ Выгружено успешно");
		КонецПопытки;
	Иначе
		Сообщить("❌ Ошибка: " + Результат.КодСостояния);
	КонецЕсли;
	
	
	
КонецПроцедуры


&НаКлиенте
Процедура ОчистититьЦены(Команда)
	Цены.Очистить();
КонецПроцедуры


