&НаКлиенте
Процедура ОчиститьПромо(Команда)
	Объект.Товары.Очистить();
КонецПроцедуры


&НаКлиенте
Процедура ОтобратьПромо(Команда)
	Объект.Товары.Очистить();
	ОтобратьПромоНаСервере();
КонецПроцедуры

// Заполняем таблицу "Товары"
&НаСервере
Процедура ОтобратьПромоНаСервере()
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПозицииПромоАкции.Номенклатура КАК Номенклатура,
	|	ПозицииПромоАкции.Номенклатура.Код КАК Код,
	|	ПозицииПромоАкции.ПромоАкция.Представление КАК ПромоАкция
	|ИЗ
	|	РегистрСведений.ПозицииПромоАкции КАК ПозицииПромоАкции
	|ГДЕ
	|	ПозицииПромоАкции.ПромоАкция = &ПромоАкция
	|
	|СГРУППИРОВАТЬ ПО
	|	ПозицииПромоАкции.Номенклатура,
	|	ПозицииПромоАкции.Номенклатура.Код,
	|	ПозицииПромоАкции.ПромоАкция.Представление"; 
	
	Запрос.УстановитьПараметр("ПромоАкция", ПромоАкция);

	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Стр = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Выборка);
	КонецЦикла;
		
КонецПроцедуры



&НаКлиенте
Процедура ВыгрузитьПромо(Команда)
	ВыгрузитьПромоНаСервере();
КонецПроцедуры
	

&НаСервере
Процедура ВыгрузитьПромоНаСервере()
	
	КолЗаписейТовары = Объект.Товары.Количество();
	
	Если КолЗаписейТовары = 0 Тогда
		Сообщить("Нет данных для выгрузки");
		Возврат;
	Иначе
		Сообщить(" Количество SKU " + Строка(КолЗаписейТовары) + " записей");	
	КонецЕсли; 
	
	// ===== ПОЛУЧАЕМ ТОКЕН ==========================
		
	//Токен = ПолучитьТокенНаСервере();
	Токен = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwicm9sZSI6ImFkbWluIiwiZXhwIjoxNzgyMjA0MTY1fQ.8rql_TXnRWEkln-mVcV4K0DFjox9mttj8nIWwMAjw1o";	

	
	Если Токен = "" Тогда
        Сообщить("Не удалось получить токен. Операция отменена.");
        Возврат;
	КонецЕсли;
    
    // ===== АДРЕС ===================================
    Адрес = "/api/v1/ml/dataset/stream";
	
	// ===============================================
	Успешных = 0;
	Ошибок = 0;
	// ===============================================
	
	// ===== ФОРМИРУЕМ NDJSON ДЛЯ ВСЕГО ПАКЕТА =====
	Поток = Новый ПотокВПамяти;
    ЗаписьТекста = Новый ЗаписьТекста(Поток, "UTF-8");
    
	
	    
    // ===== BATCH_START ===== 
	
	
	
    СтартСообщение = Новый Структура;
    СтартСообщение.Вставить("operation", "batch_start");
	//СтартСообщение.Вставить("total_count", ТЗВыгрузки.Количество()); 
	
	СтрокаJSON = ОбъектВСтрокуJSON(СтартСообщение);
	ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
	
	
	Для Каждого СКУ Из Объект.Товары Цикл
		
		СКУКод = СКУ.Код;
	    
	    ТЗВыгрузки = ПодготовитьДанныеКВыгрузкеНаСервере(СКУКод);
	    
	    Если ТЗВыгрузки = Неопределено ИЛИ ТЗВыгрузки.Количество() = 0 Тогда
	        Сообщить("Нет записей для " + СКУКод);
	        Продолжить;
		Иначе
		    Сообщить(" Подготовлено " + Строка(ТЗВыгрузки.Количество()) + " записей для" + СКУКод);
	    КонецЕсли;
	    
	
	    // ===== ФОРМИРУЕМ NDJSON ДЛЯ ЭТОГО SKU =====
		//Поток = Новый ПотокВПамяти;
		//ЗаписьТекста = Новый ЗаписьТекста(Поток, "UTF-8");
		//// ===== BATCH_START =====
		//СтартСообщение = Новый Структура;
		//СтартСообщение.Вставить("operation", "batch_start");
		//СтартСообщение.Вставить("total_count", ТЗВыгрузки.Количество()); 
		//    
		//СтрокаJSON = ОбъектВСтрокуJSON(СтартСообщение);
		//ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
	    
	    // ===== RECORDS =====
	    Для Каждого СтрокаТЗ Из ТЗВыгрузки Цикл

		    Попытка

		        ДанныеЗаписи = Новый Структура;

		        ДанныеЗаписи.Вставить("promo_id", 			 Строка(СтрокаТЗ.promo_id));
		        ДанныеЗаписи.Вставить("sku", 				 Строка(СтрокаТЗ.sku));
		        ДанныеЗаписи.Вставить("store_id", 			 Строка(СтрокаТЗ.store_id));
		        ДанныеЗаписи.Вставить("category", 			 Строка(СтрокаТЗ.category));
		        ДанныеЗаписи.Вставить("region",				 Строка(СтрокаТЗ.region));
		        ДанныеЗаписи.Вставить("store_location_type", Строка(СтрокаТЗ.store_location_type));
		        ДанныеЗаписи.Вставить("format_assortment", 	 Строка(СтрокаТЗ.format_assortment));
		        ДанныеЗаписи.Вставить("month", 				 СтрокаТЗ.month);
		        ДанныеЗаписи.Вставить("week", 				 СтрокаТЗ.week);
		        ДанныеЗаписи.Вставить("regular_price", 		 СтрокаТЗ.regular_price);
		        ДанныеЗаписи.Вставить("promo_price", 		 СтрокаТЗ.promo_price);
		        ДанныеЗаписи.Вставить("promo_mechanics", 	 Строка(СтрокаТЗ.promo_mechanics));
		        ДанныеЗаписи.Вставить("adv_carrier",  		 Строка(СтрокаТЗ.adv_carrier));
		        ДанныеЗаписи.Вставить("adv_material", 		 Строка(СтрокаТЗ.adv_material));
		        ДанныеЗаписи.Вставить("marketing_type", 	 Строка(СтрокаТЗ.marketing_type));
		        ДанныеЗаписи.Вставить("k_uplift", 			 СтрокаТЗ.k_uplift);

				//ExtraFeatures = Новый Структура;
				//ExtraFeatures.Вставить("source", "1C");
				//ExtraFeatures.Вставить("export_date", Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy"));
				//ДанныеЗаписи.Вставить("extra_features", ExtraFeatures);

		        ЗаписьСообщение = Новый Структура;
		        ЗаписьСообщение.Вставить("operation", "record");
		        ЗаписьСообщение.Вставить("data", ДанныеЗаписи); 
				
				// ===== ДИАГНОСТИКА =====
				
		        СтрокаJSON = ОбъектВСтрокуJSON(ЗаписьСообщение);   // custom function

		        Если ПустаяСтрока(СтрокаJSON) Тогда
		            Сообщить("Ошибка JSON для SKU " + Строка(СтрокаТЗ.sku));
		            Продолжить;
				КонецЕсли;

		        ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);

		    Исключение
		    	Сообщить("Ошибка записи SKU " + Строка(СтрокаТЗ.sku));
				Сообщить(ОписаниеОшибки());
			КонецПопытки; 
			
		КонецЦикла;  
		
	КонецЦикла;
		
	// ===== BATCH_END =====
    КонецСообщение = Новый Структура;
    КонецСообщение.Вставить("operation", "batch_end");
    
    СтрокаJSON = ОбъектВСтрокуJSON(КонецСообщение);
    ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
    
    ЗаписьТекста.Закрыть();
	
	// ===== ПОЛУЧАЕМ СОДЕРЖИМОЕ ===== 
	Сообщить("Размер потока: " + Строка(Поток.Размер()));
    Поток.Перейти(0, ПозицияВПотоке.Начало);
    ЧтениеТекста = Новый ЧтениеТекста(Поток, "UTF-8");
    Содержимое = ЧтениеТекста.Прочитать();
    ЧтениеТекста.Закрыть(); 
	
	// ===== ОТПРАВЛЯЕМ БАТЧ ===== 
	
	Попытка
        HTTPОтвет = ОтправитьHTTPЗапросВПоток(Содержимое, Адрес, "POST", Токен);
        
        Если HTTPОтвет.КодСостояния = 200 ИЛИ HTTPОтвет.КодСостояния = 201 Тогда
            Попытка
                ЧтениеJSONОтвет = Новый ЧтениеJSON;
                ЧтениеJSONОтвет.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
                Ответ = ПрочитатьJSON(ЧтениеJSONОтвет);
                
                Сообщить("✅ Выгрузка завершена!");  
				Успешных = Успешных + 1;
                Сообщить(" Записей: " + Строка(Ответ.records_added));
                Сообщить("⏱ Длительность: " + Строка(Ответ.duration_ms) + " мс");
                
            Исключение
                Сообщить("✅ Выгрузка завершена успешно (код " + HTTPОтвет.КодСостояния + ")");
            КонецПопытки;
		Иначе 
			Ошибок = Ошибок + 1;
            Сообщить("❌ Ошибка выгрузки: " + HTTPОтвет.КодСостояния);
            ТелоОшибки = HTTPОтвет.ПолучитьТелоКакСтроку();
            Сообщить("Текст: " + ТелоОшибки);
        КонецЕсли;
    
	Исключение
		Ошибок = Ошибок + 1;
        Сообщить("❌ Ошибка при отправке: " + ОписаниеОшибки());
    КонецПопытки;


	
	Сообщить("✅ Выгрузка завершена!");
    Сообщить("✅ Успешных SKU: " + Успешных);
    Сообщить("❌ Ошибок: " + Ошибок);
        
КонецПроцедуры


// ОСНОВНОЙ ЗАПРОС ===================================================
Функция ПодготовитьДанныеКВыгрузкеНаСервере(Код)

	СписокНоменклатуры = Объект.Товары.Выгрузить(); // Таблица "Товары"
	//Объект.Товары.Очистить(); 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписокНоменклатуры.Номенклатура КАК Номенклатура,
	|	СписокНоменклатуры.Код КАК Код
	|ПОМЕСТИТЬ втСписокНоменклатуры
	|ИЗ
	|	&СписокНоменклатуры КАК СписокНоменклатуры
	|ГДЕ
	|	СписокНоменклатуры.Код = &Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПозицииПромоАкции.ПромоАкция.Наименование КАК promo_name,
	|	ПозицииПромоАкции.Номенклатура.Код КАК sku,
	|	ПозицииПромоАкции.Номенклатура КАК articular,
	|	ПозицииПромоАкции.ПромоАкция КАК promo_id,
	|	ПозицииПромоАкции.Область КАК region,
	|	ЕСТЬNULL(ПозицииПромоАкции.Область.Наименование, ""na"") КАК region_name,
	|	ПозицииПромоАкции.ЦенаПродажиДействующая КАК regular_price,
	|	ПозицииПромоАкции.ЦенаПродажиАкционная КАК promo_price,
	|	ПозицииПромоАкции.ПроцентСниженияЦеныПродажи КАК percent_price_drop,
	|	ПозицииПромоАкции.ТекущийРегулярныйОбъемШт КАК regular_sales_qty,
	|	ПозицииПромоАкции.ИсторияПродажВПромо КАК historical_sales_qty_promo,
	|	ЕСТЬNULL(ПозицииПромоАкции.ТоварАналог.Код, ""na"") КАК analog_sku,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ПромоПоКарте)
	|				ТОГДА ""ПромоПоКарте""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ОдинПлюсОдин)
	|				ТОГДА ""ОдинПлюсОдин""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ДваПлюсОдин)
	|				ТОГДА ""ДваПлюсОдин""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ТриПлюсОдин)
	|				ТОГДА ""ТриПлюсОдин""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ЧетыреПлюсОдин)
	|				ТОГДА ""ЧетыреПлюсОдин""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.ПятьПлюсОдин)
	|				ТОГДА ""ПятьПлюсОдин""
	|			КОГДА ПозицииПромоАкции.МеханикаАкции = ЗНАЧЕНИЕ(Перечисление.МеханикаПромоАкций.Распродажа)
	|				ТОГДА ""Распродажа""
	|		КОНЕЦ, ""na"") КАК promo_mechanics,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ПозицииПромоАкции.РекламныйНоситель = ЗНАЧЕНИЕ(Перечисление.РекламныйНоситель.Каталог)
	|				ТОГДА ""Каталог""
	|			КОГДА ПозицииПромоАкции.РекламныйНоситель = ЗНАЧЕНИЕ(Перечисление.РекламныйНоситель.ЖЦ)
	|				ТОГДА ""ЖЦ""
	|			КОГДА ПозицииПромоАкции.РекламныйНоситель = ЗНАЧЕНИЕ(Перечисление.РекламныйНоситель.АлкоКаталог)
	|				ТОГДА ""АлкоКаталог""
	|			КОГДА ПозицииПромоАкции.РекламныйНоситель = ЗНАЧЕНИЕ(Перечисление.РекламныйНоситель.EDLP)
	|				ТОГДА ""EDLP""
	|		КОНЕЦ, ""na"") КАК adv_carrier,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Паук)
	|				ТОГДА ""Паук""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Обложка)
	|				ТОГДА ""Обложка""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья1)
	|				ТОГДА ""Статья1""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья2)
	|				ТОГДА ""Статья2""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья3)
	|				ТОГДА ""Статья3""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья4)
	|				ТОГДА ""Статья4""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья5)
	|				ТОГДА ""Статья5""
	|			КОГДА ПозицииПромоАкции.РекламныйМатериал = ЗНАЧЕНИЕ(Перечисление.РекламныйМатериал.Статья6)
	|				ТОГДА ""Статья6""
	|		КОНЕЦ, ""na"") КАК adv_material,
	|	ЕСТЬNULL(ПозицииПромоАкции.ФорматАссортиментаДействующий.Наименование, ""na"") КАК format_assortment,
	|	ПозицииПромоАкции.ВидРекламногоМатериала КАК marketing_type
	|ПОМЕСТИТЬ втДанныеРегистра
	|ИЗ
	|	РегистрСведений.ПозицииПромоАкции КАК ПозицииПромоАкции
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ПромоАкция = ЗНАЧЕНИЕ(Справочник.ПромоАкции.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ПозицииПромоАкции.ПромоАкция = &ПромоАкция
	|		КОНЕЦ
	|	И ПозицииПромоАкции.Номенклатура В
	|			(ВЫБРАТЬ
	|				СписокНоменклатуры.Номенклатура
	|			ИЗ
	|				втСписокНоменклатуры КАК СписокНоменклатуры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетПрогнозаПозицийПромоАкций.ПромоАкция КАК promo_id,
	|	РасчетПрогнозаПозицийПромоАкций.Область КАК region,
	|	РасчетПрогнозаПозицийПромоАкций.Номенклатура КАК articular,
	|	РасчетПрогнозаПозицийПромоАкций.Номенклатура.Код КАК sku,
	|	РасчетПрогнозаПозицийПромоАкций.Номенклатура.Представление КАК sku_name,
	|	ВЫБОР
	|		КОГДА РасчетПрогнозаПозицийПромоАкций.Номенклатура.Родитель.Родитель.Наименование ЕСТЬ НЕ NULL 
	|			ТОГДА РасчетПрогнозаПозицийПромоАкций.Номенклатура.Родитель.Родитель.Наименование
	|		КОГДА РасчетПрогнозаПозицийПромоАкций.Номенклатура.Родитель.Наименование ЕСТЬ НЕ NULL 
	|			ТОГДА РасчетПрогнозаПозицийПромоАкций.Номенклатура.Родитель.Наименование
	|		ИНАЧЕ ""ПРОЧЕЕ""
	|	КОНЕЦ КАК category,
	|	РасчетПрогнозаПозицийПромоАкций.ДатаПромо КАК ДатаПромо,
	|	РасчетПрогнозаПозицийПромоАкций.Магазин.Код КАК store_id,
	|	РасчетПрогнозаПозицийПромоАкций.Магазин.КСТ_КодВНавижн КАК store_name,
	|	РасчетПрогнозаПозицийПромоАкций.Магазин.ТипЛокации.Наименование КАК store_location_type
	|ПОМЕСТИТЬ втДанныеРасчета
	|ИЗ
	|	РегистрСведений.РасчетПрогнозаПозицийПромоАкций КАК РасчетПрогнозаПозицийПромоАкций
	|ГДЕ
	|	РасчетПрогнозаПозицийПромоАкций.Номенклатура В
	|			(ВЫБРАТЬ
	|				втСписокНоменклатуры.Номенклатура КАК Номенклатура
	|			ИЗ
	|				втСписокНоменклатуры КАК втСписокНоменклатуры)
	|	И РасчетПрогнозаПозицийПромоАкций.ПромоАкция = &ПромоАкция
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втДанныеРасчета.promo_id.Представление КАК promo_id,
	|	втДанныеРегистра.sku КАК sku,
	|	втДанныеРасчета.category КАК category,
	|	втДанныеРасчета.store_location_type КАК store_location_type,
	|	МЕСЯЦ(втДанныеРасчета.ДатаПромо) КАК month,
	|	НЕДЕЛЯ(втДанныеРасчета.ДатаПромо) КАК week,
	|	втДанныеРасчета.store_id КАК store_id,
	|	втДанныеРасчета.region.Представление КАК region,
	|	ЕСТЬNULL(втДанныеРегистра.regular_price, 0) КАК regular_price,
	|	ЕСТЬNULL(втДанныеРегистра.promo_price, 0) КАК promo_price,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(втДанныеРегистра.regular_sales_qty, 0) = 0
	|				ИЛИ ЕСТЬNULL(втДанныеРегистра.historical_sales_qty_promo, 0) = 0
	|			ТОГДА 1
	|		ИНАЧЕ ОКР(ЕСТЬNULL(втДанныеРегистра.historical_sales_qty_promo, 0) / ЕСТЬNULL(втДанныеРегистра.regular_sales_qty, 0), 3)
	|	КОНЕЦ КАК k_uplift,
	|	втДанныеРегистра.analog_sku КАК analog_sku,
	|	втДанныеРегистра.promo_mechanics КАК promo_mechanics,
	|	втДанныеРегистра.adv_carrier КАК adv_carrier,
	|	втДанныеРегистра.adv_material КАК adv_material,
	|	втДанныеРегистра.format_assortment КАК format_assortment,
	|	втДанныеРегистра.marketing_type.Представление КАК marketing_type
	|ИЗ
	|	втДанныеРегистра КАК втДанныеРегистра
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДанныеРасчета КАК втДанныеРасчета
	|		ПО втДанныеРегистра.promo_id = втДанныеРасчета.promo_id
	|			И втДанныеРегистра.region = втДанныеРасчета.region
	|			И втДанныеРегистра.articular = втДанныеРасчета.articular
	|ГДЕ
	|	ЕСТЬNULL(втДанныеРасчета.promo_id, """") <> """"";
	
	Запрос.УстановитьПараметр("ПромоАкция", ПромоАкция);   // Поле ПромоАкция
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);  // Таблица "Товары"
	Запрос.УстановитьПараметр("Код", Код);
	
	РезультатЗапроса = Запрос.Выполнить();

	ТабДанныеВыгрузки = РезультатЗапроса.Выгрузить();  // Тип ТаблицаЗначений 
	
	Если  НЕ ТабДанныеВыгрузки.Количество() Тогда
		Сообщить("Нет данных для выгрузки");
	КонецЕсли; 
			
	Возврат ТабДанныеВыгрузки;  
	
КонецФункции


//ПРЕОБРАЗОВАНИЯ ОБЪЕКТА В JSON-СТРОКУ
Функция ОбъектВСтрокуJSON(Объект)

    Попытка

        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, Объект);
        СтрокаJSON = ЗаписьJSON.Закрыть();

        СтрокаJSON = СтрЗаменить(СтрокаJSON, Символы.ПС, "");
        СтрокаJSON = СтрЗаменить(СтрокаJSON, Символы.ВК, "");
        СтрокаJSON = СтрЗаменить(СтрокаJSON, Символы.Таб, "");

        Возврат СтрокаJSON;

    Исключение

        Сообщить("Ошибка сериализации JSON: " + ОписаниеОшибки());

        Если ТипЗнч(Объект) = Тип("Структура") Тогда

            Для Каждого Элемент Из Объект Цикл

                Сообщить(Элемент.Ключ + " -> " + Строка(ТипЗнч(Элемент.Значение)));

            КонецЦикла;

        КонецЕсли;

        Возврат "";

    КонецПопытки;

КонецФункции



&НаКлиенте
Процедура ВыгрузитьПромоПоПачкам(Команда)
	Пачка = РазмерПачки;
	ВыгрузитьПромоПоПачкамНаСервере(Пачка);
КонецПроцедуры


&НаСервере
Процедура ВыгрузитьПромоПоПачкамНаСервере(Пачка)
    
    // ===== 1. ПОЛУЧАЕМ ДАННЫЕ =====
    ВсеЗаписи = Новый Массив;
    
    Для Каждого СКУ Из Объект.Товары Цикл
        СКУКод = СКУ.Код;
        ТЗВыгрузки = ПодготовитьДанныеКВыгрузкеНаСервере(СКУКод);
        
        Для Каждого СтрокаТЗ Из ТЗВыгрузки Цикл
            ВсеЗаписи.Добавить(СтрокаТЗ);
        КонецЦикла;
    КонецЦикла;
    
    ВсегоЗаписей = ВсеЗаписи.Количество();
    Если ВсегоЗаписей = 0 Тогда
        Сообщить("Нет данных для выгрузки");
        Возврат;
    КонецЕсли;
    
    Сообщить(" Всего записей: " + ВсегоЗаписей);
    
    // ===== 2. ОДИН BATCH_ID НА ВСЮ ВЫГРУЗКУ =====
    ОбщийBatchID = Строка(Новый УникальныйИдентификатор);
    Сообщить(" Batch ID: " + ОбщийBatchID);
    
    // ===== 3. ПОЛУЧАЕМ ТОКЕН =====
	//Токен = "";
	Токен = ПолучитьТокенНаСервере(); 
	Адрес = "/api/v1/ml/dataset/stream";
    
    // ===== 4. РАЗБИВАЕМ НА ПАКЕТЫ ПО 5000 ЗАПИСЕЙ =====
    РазмерПачки = Пачка;
    КоличествоПачек = Цел(ВсегоЗаписей / РазмерПачки) + ?(ВсегоЗаписей % РазмерПачки > 0, 1, 0);
    
    Сообщить(" Пачек: " + КоличествоПачек + " по " + РазмерПачки + " записей");
    
    Успешных = 0;
    Ошибок = 0;
    
    Для НомерПачки = 0 ПО КоличествоПачек - 1 Цикл
        
        Нач = НомерПачки * РазмерПачки;
        Кон = Мин(Нач + РазмерПачки - 1, ВсегоЗаписей - 1);
        КоличествоВПачке = Кон - Нач + 1;
        
        Сообщить(" Пачка " + Строка(НомерПачки + 1) + "/" + КоличествоПачек + 
                 " (записи " + Строка(Нач + 1) + "-" + Строка(Кон + 1) + ")");
        
        // ===== ФОРМИРУЕМ NDJSON ДЛЯ ПАЧКИ =====
        Поток = Новый ПотокВПамяти;
        ЗаписьТекста = Новый ЗаписьТекста(Поток, "UTF-8");
        
        // BATCH_START
        СтартСообщение = Новый Структура;
        СтартСообщение.Вставить("operation", "batch_start");
        СтартСообщение.Вставить("batch_id", ОбщийBatchID);  // ← ОДИН И ТОТ ЖЕ!   
		СтартСообщение.Вставить("promo_id", ПромоАкция.Наименование);
        СтартСообщение.Вставить("total_count", КоличествоВПачке);
        СтартСообщение.Вставить("chunk", НомерПачки + 1);
        СтартСообщение.Вставить("total_chunks", КоличествоПачек);
        
        СтрокаJSON = ОбъектВСтрокуJSON(СтартСообщение);
        ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
        
        // RECORDS
        Для Индекс = Нач ПО Кон Цикл
            СтрокаТЗ = ВсеЗаписи[Индекс];
            
            ДанныеЗаписи = Новый Структура;
            ДанныеЗаписи.Вставить("promo_id", Строка(СтрокаТЗ.promo_id));
            ДанныеЗаписи.Вставить("sku", Строка(СтрокаТЗ.sku));
            ДанныеЗаписи.Вставить("store_id", Строка(СтрокаТЗ.store_id));
            ДанныеЗаписи.Вставить("category", Строка(СтрокаТЗ.category));
            ДанныеЗаписи.Вставить("region", Строка(СтрокаТЗ.region));
            ДанныеЗаписи.Вставить("store_location_type", Строка(СтрокаТЗ.store_location_type));
            ДанныеЗаписи.Вставить("format_assortment", Строка(СтрокаТЗ.format_assortment));
            ДанныеЗаписи.Вставить("month", СтрокаТЗ.month);
            ДанныеЗаписи.Вставить("week", СтрокаТЗ.week);
            ДанныеЗаписи.Вставить("regular_price", СтрокаТЗ.regular_price);
            ДанныеЗаписи.Вставить("promo_price", СтрокаТЗ.promo_price);
            ДанныеЗаписи.Вставить("promo_mechanics", Строка(СтрокаТЗ.promo_mechanics));
            ДанныеЗаписи.Вставить("adv_carrier", Строка(СтрокаТЗ.adv_carrier));
            ДанныеЗаписи.Вставить("adv_material", Строка(СтрокаТЗ.adv_material));
            ДанныеЗаписи.Вставить("marketing_type", Строка(СтрокаТЗ.marketing_type));
            ДанныеЗаписи.Вставить("k_uplift", СтрокаТЗ.k_uplift);
            
            ЗаписьСообщение = Новый Структура;
            ЗаписьСообщение.Вставить("operation", "record");
            ЗаписьСообщение.Вставить("data", ДанныеЗаписи);
            
            СтрокаJSON = ОбъектВСтрокуJSON(ЗаписьСообщение);
            ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
        КонецЦикла;
        
        // BATCH_END
        КонецСообщение = Новый Структура;
        КонецСообщение.Вставить("operation", "batch_end");
        КонецСообщение.Вставить("batch_id", ОбщийBatchID);
        КонецСообщение.Вставить("chunk", НомерПачки + 1);
        
        СтрокаJSON = ОбъектВСтрокуJSON(КонецСообщение);
        ЗаписьТекста.ЗаписатьСтроку(СтрокаJSON);
        
        ЗаписьТекста.Закрыть();
        
        // ===== ОТПРАВЛЯЕМ ПАЧКУ =====
        Поток.Перейти(0, ПозицияВПотоке.Начало);
        ЧтениеТекста = Новый ЧтениеТекста(Поток, "UTF-8");
        Содержимое = ЧтениеТекста.Прочитать();
        ЧтениеТекста.Закрыть();
        
        Попытка
            HTTPОтвет = ОтправитьHTTPЗапросВПоток(Содержимое, Адрес, "POST", Токен);
            
            Если HTTPОтвет.КодСостояния = 200 ИЛИ HTTPОтвет.КодСостояния = 201 Тогда
                Успешных = Успешных + 1;
                Сообщить("✅ Пачка " + Строка(НомерПачки + 1) + " отправлена");
            Иначе
                Ошибок = Ошибок + 1;
                Сообщить("❌ Ошибка пачки " + Строка(НомерПачки + 1) + ": " + HTTPОтвет.КодСостояния);
                Сообщить(HTTPОтвет.ПолучитьТелоКакСтроку());
                Прервать;
            КонецЕсли;
            
        Исключение
            Ошибок = Ошибок + 1;
            Сообщить("❌ Ошибка пачки " + Строка(НомерПачки + 1) + ": " + ОписаниеОшибки());
            Прервать;
        КонецПопытки;
        
    КонецЦикла;
    
    Сообщить("✅ Выгрузка завершена!");
    Сообщить("✅ Успешных пачек: " + Успешных + "/" + КоличествоПачек);
    Сообщить("❌ Ошибок: " + Ошибок);
    
КонецПроцедуры

